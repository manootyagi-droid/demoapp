pipeline {
    agent any

    environment {
        IMAGE_NAME = "manootyagi/demoapp"
        CONTAINER_NAME = "demoapp-container"
    }

    stages {

        stage('Clone Code') {
            steps {
                git branch: 'main',
                    url: 'https://github.com/manootyagi-droid/demoapp.git'
            }
        }

        stage('Build') {
            steps {
                sh 'mvn clean package'
            }
        }

        stage('Docker Build') {
            steps {
                sh 'docker build -t $IMAGE_NAME .'
            }
        }

        stage('Stop Old Container') {
            steps {
                sh 'docker rm -f $CONTAINER_NAME || true'
            }
        }

        stage('Run Container') {
            steps {
                sh 'docker run -d -p 9090:9090 --name $CONTAINER_NAME $IMAGE_NAME'
            }
        }
    }
}
